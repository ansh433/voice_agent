# Stage 0 database settings
DATABASE_URL=postgresql://motor_mitra:motor_mitra@localhost:5432/motor_mitra
TEST_DATABASE_URL=postgresql://motor_mitra:motor_mitra@localhost:5433/motor_mitra_test
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=2.0
DATABASE_COMMAND_TIMEOUT_SECONDS=2.0
BUSINESS_TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Stage 1 provider settings (leave blank until browser voice work begins)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=motor-mitra-service-desk
BROWSER_AUTH_TOKEN=replace-with-a-long-random-development-token
WEB_ALLOWED_ORIGIN=http://localhost:5173
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ELEVEN_API_KEY=
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVEN_LANGUAGE=hi

# Optional Langfuse observability. Leave keys blank to disable external tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Synthetic test data only. Set false to redact conversational content from Langfuse.
LANGFUSE_CAPTURE_PII=true
